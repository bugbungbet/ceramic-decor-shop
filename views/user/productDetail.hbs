{{#> _wrappers/user-wrapper}}

<div class="productDetail-page">

    {{> _user/header-products}}

    <div class="container product-detail-container">
        <div class="back-button">
            <a href="javascript:void(0);" id="btnBack">
                <i class="bi bi-arrow-left"></i> Sản phẩm
            </a>
            <span class="separator">•</span>
            <span>Chi tiết sản phẩm</span>
        </div>
        <div class="product-detail-grid">
            <!-- Bên trái: ảnh sản phẩm -->
            <div class="product-images">
                <div class="thumbnail-images">
                    {{#each product.images}}
                    <img class="thumbnail" src="{{this}}" alt="{{../product.name}}">
                    {{/each}}
                </div>

                <div class="main-image">
                    <img id="mainProductImage" src="{{product.images.[0]}}" alt="{{product.name}}">
                </div>
            </div>

            <!-- Bên phải: thông tin sản phẩm -->
            <div class="product-info">
                <h2 class="product-name">{{product.name}}</h2>
                <div class="price-quantity-group">
                    <p class="product-price">{{formatCurrency product.price}}</p>

                    <div class="quantity-selector">
                        <button id="decreaseQty">-</button>
                        <input type="number" id="productQty" value="1" min="1">
                        <button id="increaseQty">+</button>
                    </div>
                </div>


                <!-- Thêm vào giỏ hàng -->
                <button id="addToCart" data-id="{{product._id}}" data-price="{{product.price}}" class="btn-add-cart"><i
                        class="bi bi-cart"></i> Thêm vào giỏ hàng</button>
                <!-- Mua ngay -->
                <button id="buyNow" data-id="{{product._id}}" data-price="{{product.price}}" class="btn-buy-now">
                    Mua ngay <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
        <!-- Thông tin chi tiết sản phẩm -->
    </div>
    <hr style="margin: 56px 0;">
    <div class="container">
        <div class="product-extra-info">
            <div class="extra-info-grid">
                <div class="extra-info-item">
                    <h4>Giới thiệu sản phẩm</h4>
                    <p>{{#if product.introduction}}{{product.introduction}}{{else}}Đang cập nhật…{{/if}}</p>
                </div>
                <div class="extra-info-item">
                    <h4>Thông tin chất liệu</h4>
                    <p>{{#if product.details}}{{product.details}}{{else}}Đang cập nhật…{{/if}}</p>
                </div>
                <div class="extra-info-item">
                    <h4>Gợi ý trưng bày</h4>
                    <p>{{#if product.displaySuggestion}}{{product.displaySuggestion}}{{else}}Đang cập nhật…{{/if}}</p>
                </div>
                <div class="extra-info-item">
                    <h4>Hướng dẫn bảo quản</h4>
                    <p>{{#if product.preservationGuide}}{{product.preservationGuide}}{{else}}Đang cập nhật…{{/if}}</p>
                </div>

            </div>
        </div>
    </div>
    <hr style="margin: 56px 0;">
    <div class="container">
        <div class="product-reviews">
            <div class="reviews-header">
                <div class="left">
                    <h2 class="mb-1">ĐÁNH GIÁ SẢN PHẨM</h2>
                    <p class="text-muted">Đã bán {{product.soldCount}} sản phẩm</p>
                </div>
                <div class="right">
                    {{#if totalReviews}}
                    <div class="rating-average">
                        <div class="average-number">{{averageRating}}</div>
                        <div class="rating-group">
                            <div class="rating-stars">
                                {{#each (range 1 5)}}
                                <i class="bi {{#if (lte this ../averageRating)}}bi-star-fill{{else}}bi-star{{/if}}"></i>
                                {{/each}}
                            </div>
                            <div class="total-reviews">
                                Đánh giá bởi ({{totalReviews}} người)
                            </div>
                        </div>
                    </div>
                    {{else}}
                    <div class="no-reviews">
                        Chưa có đánh giá nào
                    </div>
                    {{/if}}
                </div>



            </div>

            {{#if reviews.length}}
            <div class="reviews-grid">
                {{#each reviews}}
                <div class="review-card">
                    {{!-- <div class="review-header">
                        <img src="{{this.userId.avatarUrl}}" alt="{{this.userId.fullName}}" class="review-avatar">
                        <div>
                            <strong>{{this.userId.fullName}}</strong>
                            <div class="rating-stars">
                                {{#each (range 1 5)}}
                                <i class="bi {{#if (lte this ../rating)}}bi-star-fill{{else}}bi-star{{/if}}"></i>
                                {{/each}}
                            </div>
                            <small class="text-muted">{{formatDate this.createdAt}}</small>
                        </div>
                    </div> --}}

                    <div class="review-header">
                        <div class="review-user-info">
                            <img src="{{this.userId.avatarUrl}}" alt="{{this.userId.fullName}}" class="review-avatar">
                            <div class="user-details">
                                <strong>{{this.userId.fullName}}</strong>
                                <div class="rating-stars">
                                    {{#each (range 1 5)}}
                                    <i class="bi {{#if (lte this ../rating)}}bi-star-fill{{else}}bi-star{{/if}}"></i>
                                    {{/each}}
                                </div>
                            </div>
                        </div>
                        <div class="review-date">
                            <p>Ngày đăng</p>
                            <small>{{formatDate this.createdAt}}</small>
                        </div>
                    </div>

                    <hr style="margin: 16px 0;border-color: #EEEDE5;">

                    <div class="review-body">

                        {{#if this.images.length}}
                        <div class="review-images">
                            {{#each this.images}}
                            <img src="{{this}}" class="review-image" alt="review image">
                            {{/each}}
                        </div>
                        {{/if}}
                        <p class="comment">{{this.comment}}</p>

                    </div>
                </div>
                {{/each}}

            </div>
            {{else}}
            <p class="text-center text-muted">Chưa có đánh giá nào cho sản phẩm này.</p>
            {{/if}}

        </div>
    </div>
    {{> _user/footer}}
</div>

<script type="module" src="/javascripts/user/productDetail.module.js"></script>
<script>
    document.getElementById('btnBack').addEventListener('click', () => {
        if (document.referrer) {
            // Nếu có trang trước đó, quay lại
            window.history.back();
        } else {
            // Nếu không có trang trước đó (vào trực tiếp), chuyển về /products
            window.location.href = '/products';
        }
    });
</script>
{{/ _wrappers/user-wrapper}}