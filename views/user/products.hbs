{{#> _wrappers/user-wrapper}}

<div class="products-page home-page">

    {{> _user/header-products}}

    <section class="banner">
        <img src="./images/banner-products.png" alt="Banner gốm sứ" class="banner-bg">
        <div class="banner-content">
            <div class="container">
                <form action="/products" method="GET" class="banner-search">
                    <div class="search-box">
                        <span class="search-icon"><i class="bi bi-search"></i></span>
                        <input type="text" name="q" placeholder="Tìm kiếm sản phẩm..." />
                        <button type="submit" class="search-btn"><i class="bi bi-send"></i></button>
                    </div>
                </form>
                <h1>BranDecO</h1>
                <p>Từ sự kết hợp giữa thẩm mỹ hiện đại và vẻ đẹp tự nhiên, BranDeco không chỉ tạo ra đồ gốm – chúng tôi
                    gìn
                    giữ
                    cảm xúc, hơi thở và câu chuyện của đất. <br> Mỗi đường cong, mỗi lớp men đều mang dấu ấn của bàn tay
                    và
                    thời
                    gian.</p>
            </div>
        </div>
    </section>

    <section class="product-section">
        <div class="container">
            <div class="product-controls">
                <!-- Filter danh mục -->
                <div class="filter-category">
                    <span class="category-btn active" data-category="all">Tất cả</span>

                    {{!-- <span class="category-btn" data-category="category1">Danh mục 1</span>
                    <span class="category-btn" data-category="category2">Danh mục 2</span> --}}
                    {{#each allCategories}}
                    <span class="category-btn" data-category="{{this._id}}">{{this.name}}</span>
                    {{/each}}
                </div>


                <!-- Sắp xếp giá -->
                <div class="sort-price">
                    <label>Giá:</label>
                    <button class="sort-btn" data-sort="asc"><i class="bi bi-arrow-up-circle"></i></button>
                    <button class="sort-btn" data-sort="desc"><i class="bi bi-arrow-down-circle"></i></button>
                </div>
            </div>

            <!-- Danh sách sản phẩm -->
            <div class="product-list">
                {{#each allProducts}}
                <a href="#" class="product-item">
                    <img src="{{this.images.[0]}}" alt="{{this.name}}">
                    <h4 class="product-name">{{this.name}}</h4>
                    <p class="product-price">{{formatCurrency this.price}}</p>
                </a>
                {{/each}}
