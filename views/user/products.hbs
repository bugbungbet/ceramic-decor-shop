<script>
    document.addEventListener('DOMContentLoaded', () => {
        const items = document.querySelectorAll('.new-products-section .product-item');
        const prevBtn = document.querySelector('.new-products-section .btn-nav.prev');
        const nextBtn = document.querySelector('.new-products-section .btn-nav.next');
        const perPage = 4;
        const total = items.length;
        let start = 0;

        function updateView() {
            items.forEach((item, index) => {
                item.style.display = (index >= start && index < start + perPage) ? 'block' : 'none';
            });
        }

        prevBtn.addEventListener('click', () => {
            start -= perPage;
            if (start < 0) start = Math.max(total - perPage, 0); // quay về cuối nếu start < 0
            updateView();
        });

        nextBtn.addEventListener('click', () => {
            start += perPage;
            if (start >= total) start = 0; // quay về đầu nếu vượt
            updateView();
        });

        updateView(); // lần đầu hiển thị
    });


</script>

