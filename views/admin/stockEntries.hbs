{{#> _wrappers/admin-wrapper}}


<div class="stockEntries-page">
    <div class="page-header">
        <h1 class="page-title">{{title}}</h1>
        {{!-- <button class="add-stockEntry-btn action-add-btn animate-slide-in-up">
            <i class="bi bi-plus-circle"></i>
            Thêm lô nhập mới
        </button> --}}
    </div>

    <div class="page-content">
        <div class="section animate-slide-in-up mt-2">
            <table class="table">
                <thead>
                    <tr>
                        <th class="fit center">#</th>
                        <th class="w-3">Tên sản phẩm</th>
                        <th class="fit center">Ảnh</th>
                        <th class="w-3 center">Số lượng lô hàng</th>
                        <th class="w-3 center">Đã nhập</th>
                        <th class="w-3 center">Tổng tồn kho</th>
                        <th class="w-3 center">Giá bán</th>
                        {{!-- <th class="fit center">Hiển thị</th> --}}
                        <th class="fit center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    {{#if stockOverview.length}}

                    {{#each stockOverview}}
                    <tr>
                        <td class="fit center">{{plusOne @index}}</td>
                        <td><span class="ellipsis line-2">{{this.name}}</span></td>
                        <td class="fit center">
                            <img class="product-image table-image" src="{{this.image}}" alt="{{this.name}}" />
                        </td>
                        <td class="center"><span class="">{{this.totalBatches}}</span></td>
                        <td class="center"><span class="">{{this.totalImported}}</span></td>
                        <td class="center"><span class="">{{this.totalStock}}</span></td>
                        <td class="center"><span class="">{{formatCurrency this.price}}</span></td>

                        {{!-- <td class="fit center">
                            <div class="switch" data-active="{{this.isActive}}" data-id="{{this._id}}">
                                <div class="switch-slider"></div>
                            </div>
                        </td> --}}

                        <td class="fit center">
                            <div class="action-group">
                                {{!-- <button class="action-btn edit-btn" data-id="{{this._id}}" title="Sửa thông tin">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <div class="action-divider"></div>
                                <button class="action-btn delete-btn {{#unless this.isDelete}}disabled{{/unless}}"
                                    data-id="{{this._id}}" title="Xoá danh mục">
                                    <i class="bi bi-trash3"></i>
                                </button> --}}
                                <a href="/admin/products/{{this.productId}}" class="action-btn detail-btn"
                                    data-id="{{this.productId}}" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </a>

                            </div>
                        </td>
                    </tr>
                    {{/each}}

                    {{else}}
                    <tr>
                        <td colspan="8" class="center">Chưa có dữ liệu</td>
                    </tr>
                    {{/if}}

                </tbody>
            </table>
        </div>


        {{> _admin/pagination pagination=pagination currentSortField=currentSortField
        currentSortOrder=currentSortOrder}}


        {{> _admin/stockEntries/add}}

        {{> _admin/stockEntries/edit}}
    </div>

</div>

{{!--
<script type="module" src="/javascripts/admin/{{activePage}}.module.js"></script> --}}

{{/ _wrappers/admin-wrapper}}