<div id="modalAddCategory" class="modal-wrapper">
    <div class="modal-overlay"></div>
    <div class="modal-panel">
        <div class="modal-header">
            <h3>Thêm Danh Mục</h3>
            <button class="modal-close"><i class="bi bi-x-lg"></i></button>
        </div>
        <hr>
        <div class="modal-body">
            <form id="formAddCategory">
                <div class="form-group">
                    <label for="addCategoryName">Tên danh mục <span class="error">*</span></label>
                    <input type="text" id="addCategoryName" name="name" required />
                </div>

                <div class="form-group">
                    <label for="addCategoryParentId">Danh mục cha</label>
                    <select name="parentId" id="addCategoryParentId">
                        <option value="">-- Không có danh mục cha --</option>
                        {{#each allCategories}}
                        <option value="{{this._id}}">{{this.name}}</option>
                        {{/each}}
                    </select>
                </div>

                <div class="form-group">
                    <label for="addCategoryDesc">Mô tả</label>
                    <textarea id="addCategoryDesc" name="description"></textarea>
                </div>
                <hr>
                <div class="form-actions">
                    <button type="submit" class="btn-primary">Thêm</button>
                    <button type="button" class="btn-secondary modal-close">Huỷ</button>
                </div>
            </form>
        </div>
    </div>
</div>